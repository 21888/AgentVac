+    await processObservationProfileEnabled({
+      packaged: false,
+      optIn: "1",
+      testUserData: profile,
+      profile,
+    }),
+    false,
+  );
+  assert.equal(readCalls, 1);
+  assert.equal(requestedBytes, 43);
+});
