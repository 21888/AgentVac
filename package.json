{
  "name": "agentvac",
  "version": "0.2.0",
  "private": true,
  "description": "Conservative local cleanup with provider-bound previews and reversible quarantine",
  "author": "AgentVac contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && node --import tsx scripts/e2e.mjs",
    "start": "electron .",
    "preview": "vite --host 127.0.0.1",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:linux": "npm run build && electron-builder --linux --x64",
    "format": "prettier --write src electron shared tests scripts *.json *.ts index.html README.md",
    "test:desktop": "npm run build && node scripts/desktop-e2e.mjs",
    "test:ux": "npm run build && node --import tsx scripts/ux-regression.mjs",
    "test:bulk": "npm run build && node --import tsx scripts/bulk-selection-regression.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "test:accessibility": "npm run build && node --import tsx scripts/accessibility-regression.mjs",
    "test:app-data": "npm run build && node --import tsx scripts/app-data-regression.mjs",
    "test:scan": "npm run build && node --import tsx scripts/scan-regression.mjs",
    "test:performance": "node --import tsx scripts/benchmark-batch.mjs",
    "test:desktop:built": "node scripts/desktop-e2e.mjs",
    "test:providers": "npm run build && node --import tsx scripts/multi-provider-regression.mjs"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "axe-core": "^4.13.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  },
  "build": {
    "appId": "app.agentvac.desktop",
    "productName": "AgentVac",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "build/icon.png"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Utility",
      "maintainer": "AgentVac contributors",
      "syncDesktopName": true
    },
    "icon": "build/icon.png",
    "afterPack": "scripts/after-pack.cjs",
    "afterExtract": "scripts/after-extract.cjs",
    "asarUnpack": [
      "dist-electron/diagnostic-supervisor.cjs",
      "dist-electron/diagnostic-worker.cjs",
      "dist-electron/cursor-sql-worker.cjs",
      "dist-electron/process-argv-worker.cjs"
    ]
  },
  "desktopName": "app.agentvac.desktop",
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  }
}
